# Local SQLite database. Point this at your own file or a Postgres URL if you
# switch the datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Required. Any long random string — the server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional. The time zone that decides when a "day" starts for the automatic
# daily backup. Defaults to Asia/Dhaka.
# APP_TIMEZONE="Asia/Dhaka"
