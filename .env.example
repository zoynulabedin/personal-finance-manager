# Local SQLite database. Point this at your own file or a Postgres URL if you
# switch the datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Required. Any long random string — the server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
