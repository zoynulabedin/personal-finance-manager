// Prisma schema file for Multi-User Personal Family Finance Manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Bumped whenever the password changes. Sessions carry the version they were
  // issued with, so a password change invalidates every other device.
  sessionVersion Int @default(0)

  incomes      Income[]
  bankAccounts BankAccount[]
  categories   Category[]
  expenses     Expense[]
  bills        Bill[]
}

model Income {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  month     Int
  year      Int
  note      String?
  createdAt DateTime   @default(now())
  donations Donation[]

  @@index([userId, year, month])
  @@index([userId, createdAt])
}

model Donation {
  id            String       @id @default(uuid())
  incomeId      String
  income        Income       @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  percentage    Float        @default(1.0)
  amount        Float
  paid          Boolean      @default(false)
  paidDate      DateTime?
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([incomeId])
  @@index([bankAccountId])
  @@index([paid])
}

model BankAccount {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName       String
  accountName    String
  accountNumber  String
  currentBalance Float      @default(0.0)
  // Explicit flag instead of matching on bankName == "Cash", so the dashboard
  // can split cash from bank reliably and support more than one cash wallet.
  isCash         Boolean    @default(false)
  note           String?
  createdAt      DateTime   @default(now())
  expenses       Expense[]
  donations      Donation[]

  @@index([userId])
}

model Category {
  id       String    @id @default(uuid())
  userId   String?
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  icon     String?
  color    String?
  type     String    @default("EXPENSE")
  expenses Expense[]

  @@index([userId])
}

model Expense {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime     @default(now())
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title         String
  amount        Float
  paymentMethod String // Cash, Bank, bKash, Nagad, Rocket
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  // True when this expense's amount was deducted from bankAccountId. Lets edits
  // and deletes reverse exactly what was applied, instead of guessing.
  balanceApplied Boolean     @default(false)
  note           String?
  createdAt      DateTime    @default(now())

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([bankAccountId])
}

model Bill {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  dueDate   DateTime
  paid      Boolean   @default(false)
  paidDate  DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@index([userId, dueDate])
  @@index([userId, paid])
}
